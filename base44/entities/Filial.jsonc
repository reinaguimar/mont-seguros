{
  "name": "Filial",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da filial"
    },
    "codigo_susep": {
      "type": "string",
      "description": "Codigo SUSEP global da seguradora (6 digitos) - compartilhado entre filiais"
    },
    "codigo_filial": {
      "type": "string",
      "description": "Codigo unico da filial (2 chars alfanumerico) - usado no numero da apolice como XX em: SUSEP.ANO.031.XX.SEQ.REC"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da filial"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade da filial"
    },
    "estado": {
      "type": "string",
      "description": "UF da filial"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a filial esta ativa para emissao"
    },
    "ultimo_numero_sequencial": {
      "type": "number",
      "default": 0,
      "description": "Ultimo numero sequencial YYYYY usado por esta filial"
    },
    "total_apolices": {
      "type": "number",
      "default": 0,
      "description": "Total de apolices emitidas por esta filial"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "matriz",
        "sub_representante"
      ],
      "default": "sub_representante",
      "description": "Tipo: matriz ou sub-representante"
    },
    "produtos_permitidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Produtos que esta filial pode comercializar na apolice. Valores: FR, RCFV, COL_PARCIAL, COL_TOTAL, INCENDIO"
    },
    "rcfv_lmis_permitidos": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Limites de RCF-V (LMI) que esta filial pode comercializar. Valores possiveis: 30000, 50000, 100000"
    },
    "rcfv_preco_30000": {
      "type": "number",
      "default": 35.9,
      "description": "Premio fixo (R$) do RCF-V para o LMI de R$ 30.000, aplicado na emissao"
    },
    "rcfv_preco_50000": {
      "type": "number",
      "default": 35.9,
      "description": "Premio fixo (R$) do RCF-V para o LMI de R$ 50.000, aplicado na emissao"
    },
    "rcfv_preco_100000": {
      "type": "number",
      "default": 35.9,
      "description": "Premio fixo (R$) do RCF-V para o LMI de R$ 100.000, aplicado na emissao"
    },
    "logo_url": {
      "type": "string",
      "description": "URL da logo da filial para uso no certificado"
    },
    "franquia_percentual": {
      "type": "number",
      "default": 6,
      "description": "Percentual de franquia sobre o LMI (ex: 6 = 6%)"
    },
    "site": {
      "type": "string",
      "description": "Site da filial"
    },
    "telefone_sac": {
      "type": "string",
      "description": "Telefone do SAC"
    },
    "email_sac": {
      "type": "string",
      "description": "E-mail do SAC"
    },
    "telefone_ouvidoria": {
      "type": "string",
      "description": "Telefone da ouvidoria"
    },
    "email_ouvidoria": {
      "type": "string",
      "description": "E-mail da ouvidoria"
    },
    "cor_primaria": {
      "type": "string",
      "description": "Cor principal da identidade visual em hex."
    },
    "cor_texto_cabecalho": {
      "type": "string",
      "description": "Cor do texto no cabecalho."
    }
  },
  "required": [
    "nome",
    "codigo_susep",
    "codigo_filial"
  ]
}